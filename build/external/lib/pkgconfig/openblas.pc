libdir=/home/wanderer/Jobs/dsnote-qt6/build/external/lib
libnameprefix=
libnamesuffix=
libsuffix=
includedir=/home/wanderer/Jobs/dsnote-qt6/build/external//home/wanderer/Jobs/dsnote-qt6/build/external/include/openblas

openblas_config=USE_64BITINT= NO_CBLAS= NO_LAPACK=1 NO_LAPACKE=1 DYNAMIC_ARCH=ON DYNAMIC_OLDER=OFF NO_AFFINITY=ON USE_OPENMP= CORE2 MAX_THREADS=8 
Name: OpenBLAS
Description: OpenBLAS is an optimized BLAS library based on GotoBLAS2 1.13 BSD version
Version: 0.3.29
URL: https://github.com/OpenMathLib/OpenBLAS
Libs: -L${libdir} -l${libnameprefix}openblas${libnamesuffix}${libsuffix} 
Cflags: -I${includedir}  
